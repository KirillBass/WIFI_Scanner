<controls:PlotViewBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WirelessSecurityAnalyzer.App.Controls" xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels"
             xmlns:plot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="WirelessSecurityAnalyzer.App.Views.ChannelsView" x:DataType="vm:ChannelsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,140,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Каналы" Classes="title" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="ChannelBandSelector" ItemsSource="{Binding Bands}" SelectedIndex="{Binding SelectedBandIndex}" HorizontalAlignment="Stretch" />
      <Button Grid.Column="2" x:Name="RefreshButton" Content="Обновить эфир" Classes="primary" Command="{Binding RefreshAnalysisCommand}" />
      <Button Grid.Column="3" Content="Остановить" Command="{Binding RefreshAnalysisCancelCommand}" IsVisible="{Binding IsBusy}" />
    </Grid>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
    <StackPanel Grid.Row="2" Spacing="5">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WifiErrorTemplate}" IsVisible="{Binding HasError}" />
      <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasError}" Classes="subtitle" />
    </StackPanel>
    <Border Grid.Row="3" Classes="card" Padding="5" ClipToBounds="True">
      <Grid>
        <plot:AvaPlot x:Name="ChannelPlot" />
        <Border Background="{DynamicResource CardBrush}" IsVisible="{Binding !HasAnalysis}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14" MaxWidth="600">
          <TextBlock Text="{Binding EmptyText}" Classes="subtitle" TextAlignment="Center" />
        </Border>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Spacing="4">
      <TextBlock x:Name="ChannelSummaryText" Text="{Binding ChannelSummary}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding SnapshotText}" />
      <TextBlock Text="Результат анализа" Classes="section" />
      <TextBlock x:Name="AnalysisResultTextBlock" Text="{Binding AnalysisResultText}" Classes="subtitle"
                 ToolTip.Tip="Программа оценивает влияние обнаруженных сетей по уровню сигнала и перекрытию каналов. Фактическая загрузка эфира не измеряется. Доступность канала можно проверить в настройках роутера." />
      <TextBlock Text="{Binding DataNotesText}" IsVisible="{Binding HasDataNotes}" Classes="subtitle" />
    </StackPanel>
    <TextBlock Grid.Row="5" x:Name="CurveDetails" Text="Наведите курсор на кривую: SSID, MAC-адрес, канал и RSSI." Classes="subtitle" MinHeight="20" />
  </Grid>
</controls:PlotViewBase>
