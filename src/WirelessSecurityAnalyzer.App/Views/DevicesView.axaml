<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" xmlns:models="using:WirelessSecurityAnalyzer.Core.Models"
             x:Class="WirelessSecurityAnalyzer.App.Views.DevicesView" x:DataType="vm:DevicesViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
    <TextBlock Text="Устройства локальной сети" Classes="title" ToolTip.Tip="Узлы выбранной IPv4-подсети. Этот список не определяет клиентов конкретной точки доступа." />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Stretch" PlaceholderText="Выберите IPv4-интерфейс">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="models:LocalNetworkInfo"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="Обновить интерфейсы" Command="{Binding RefreshInterfacesCommand}" />
    </Grid>
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock Text="{Binding NetworkSummary}" Classes="subtitle" />
      <WrapPanel>
        <Button Content="Сканировать" Classes="primary" Command="{Binding ScanCommand}" Margin="0,0,10,4" />
        <Button Content="Остановить" Command="{Binding StopMonitoringCommand}" Margin="0,0,10,4" />
        <Button Content="Перейти к аудиту" Classes="link" Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="Сетевой аудит" />
      </WrapPanel>
      <Expander Header="Имена и мониторинг" HorizontalAlignment="Stretch">
        <StackPanel Spacing="6" MaxHeight="130">
          <WrapPanel>
            <Button Content="Обновить имена" Command="{Binding RefreshNamesCommand}" Margin="0,0,10,4" />
            <Button Content="Начать мониторинг" Command="{Binding StartMonitoringCommand}" Margin="0,0,10,4" />
            <TextBlock Text="Интервал, сек:" VerticalAlignment="Center" Margin="0,0,8,4" />
            <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}" IsEnabled="{Binding CanConfigure}" Width="90" />
          </WrapPanel>
          <TextBlock Text="{Binding InterfaceText}" Classes="subtitle" />
          <TextBlock Text="IP и MAC появляются сразу, имена и производители уточняются отдельно. «Остановить» отменяет и поиск имён." Classes="subtitle" />
        </StackPanel>
      </Expander>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="6">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ReadinessText}" Classes="subtitle" />
      <Border Classes="card" IsVisible="{Binding HasError}" BorderBrush="{DynamicResource ErrorBrush}" Padding="12">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="card" IsVisible="{Binding HasWarning}" BorderBrush="{DynamicResource WarningBrush}" Padding="12">
        <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
      </Border>
      <StackPanel IsVisible="{Binding HasProgress}" Spacing="6">
        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="4" />
        <TextBlock Text="{Binding ProgressText}" Classes="subtitle" TextWrapping="Wrap" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsResolvingIdentities}" Height="3" />
      <Grid ColumnDefinitions="*,190,180" ColumnSpacing="10">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Поиск по IP, MAC, имени или производителю" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding StateFilters}" SelectedIndex="{Binding SelectedStateIndex}" HorizontalAlignment="Stretch" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSortIndex}" HorizontalAlignment="Stretch" />
      </Grid>
    </StackPanel>
      <Border Grid.Row="4" Classes="card" Padding="0" ClipToBounds="True" MinHeight="140">
        <Grid>
          <TableView ItemsSource="{Binding Devices}" CanUserResizeColumns="True" ScrollViewer.AllowAutoHide="False">
            <TableView.Columns>
              <TableViewColumn Header="IP" Binding="{ReflectionBinding Ip}" Width="135" />
              <TableViewColumn Header="Роль" Binding="{ReflectionBinding Role}" Width="90" />
              <TableViewColumn Header="Имя устройства" Width="180">
                <TableViewColumn.CellTemplate><DataTemplate x:DataType="vm:DeviceRowViewModel">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentityDetails}" />
                </DataTemplate></TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="Производитель" Width="170">
                <TableViewColumn.CellTemplate><DataTemplate x:DataType="vm:DeviceRowViewModel">
                  <TextBlock Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentityDetails}" />
                </DataTemplate></TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="MAC" Binding="{ReflectionBinding Mac}" Width="155" />
              <TableViewColumn Header="Ping" Binding="{ReflectionBinding Latency}" Width="70" />
              <TableViewColumn Header="Состояние" Width="95">
                <TableViewColumn.CellTemplate><DataTemplate x:DataType="vm:DeviceRowViewModel">
                  <Grid ToolTip.Tip="{Binding StateDescription}">
                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource SignalBrush}" IsVisible="{Binding IsOnline}" />
                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsUnknown}" />
                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsOffline}" />
                  </Grid>
                </DataTemplate></TableViewColumn.CellTemplate>
              </TableViewColumn>
              <TableViewColumn Header="Последний раз" Binding="{ReflectionBinding LastSeen}" Width="135" />
              <TableViewColumn Header="Первый раз" Binding="{ReflectionBinding FirstSeen}" Width="135" />
            </TableView.Columns>
          </TableView>
          <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" />
        </Grid>
      </Border>
    <StackPanel Grid.Row="5" Spacing="4" ToolTip.Tip="Сон устройства, изоляция клиентов и фильтрация могут ограничивать обнаружение. Отсутствие ответа не доказывает выключение устройства. История хранится до закрытия приложения.">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{Binding LastScanText}" Classes="subtitle" Margin="0,0,24,0" />
        <TextBlock IsVisible="{Binding HasDeviceStatistics}" Text="{Binding KnownCount, StringFormat='Известно: {0}'}" Classes="subtitle" Margin="0,0,18,0" />
        <TextBlock IsVisible="{Binding HasDeviceStatistics}" Text="{Binding OnlineCount, StringFormat='Online: {0}'}" Classes="subtitle" Margin="0,0,18,0" />
        <TextBlock IsVisible="{Binding HasDeviceStatistics}" Text="{Binding UnknownCount, StringFormat='Unknown: {0}'}" Classes="subtitle" Margin="0,0,18,0" />
        <TextBlock IsVisible="{Binding HasDeviceStatistics}" Text="{Binding OfflineCount, StringFormat='Offline: {0}'}" Classes="subtitle" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
