<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" xmlns:audit="using:WirelessSecurityAnalyzer.Core.NetworkAudit"
             xmlns:controls="using:WirelessSecurityAnalyzer.App.Controls"
             x:Class="WirelessSecurityAnalyzer.App.Views.NetworkAuditView" x:DataType="vm:NetworkAuditViewModel">
  <UserControl.Resources><controls:SiteRowBrushConverter x:Key="SiteRowBrush" /></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TableView#AuditResultsTable TableViewRow">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}}" />
    </Style>
    <Style Selector="TableView#AuditResultsTable TableViewRow:selected">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}, ConverterParameter=selected}" />
    </Style>
    <Style Selector="TableView#AuditResultsTable TableViewRow:selected /template/ Border#Border">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}, ConverterParameter=selected}" />
    </Style>
    <Style Selector="TableView#AuditResultsTable TableViewRow:pointerover /template/ Border#Border">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}, ConverterParameter=pointer}" />
    </Style>
    <Style Selector="TableView#AuditResultsTable TableViewRow:pressed /template/ Border#Border">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}, ConverterParameter=pressed}" />
    </Style>
    <Style Selector="TableView#AuditResultsTable TableViewRow:selected:pointerover /template/ Border#Border">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}, ConverterParameter=selected-pointer}" />
    </Style>
    <Style Selector="TableView#AuditResultsTable TableViewRow:selected:pressed /template/ Border#Border">
      <Setter Property="Background" Value="{ReflectionBinding HighlightResult, Converter={StaticResource SiteRowBrush}, ConverterParameter=selected-pressed}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock Text="Сетевой аудит" Classes="title" />
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" ColumnSpacing="12">
          <TextBlock Text="{Binding ContextSummary}" Classes="subtitle" VerticalAlignment="Center" MaxWidth="600" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding Session.Summary}" />

        </Grid>
      </StackPanel>
      <Button Grid.Column="1" x:Name="AuditPrimaryButton" Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}" Classes="primary" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,260,Auto,*" ColumnSpacing="8">
      <TextBlock Text="Профиль портов:" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedIndex="{Binding SelectedProfileIndex}" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Stretch" />
      <ToggleButton Grid.Column="2" Content="Параметры" IsEnabled="{Binding CanEditParameters}" IsChecked="{Binding IsAdvancedExpanded, Mode=TwoWay}" />
      <TextBlock Grid.Column="3" Text="Порты 1-65535 на каждом узле. Проверка может быть долгой." IsVisible="{Binding IsFullProfile}" Classes="subtitle" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="2" x:Name="AuditParametersPanel" Classes="card" IsVisible="{Binding IsAdvancedExpanded}" Padding="8">
      <ScrollViewer MaxHeight="145" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,4,6,6" IsEnabled="{Binding CanConfigure}">
          <CheckBox Content="Включить этот ПК" IsChecked="{Binding IncludeLocal}" ToolTip.Tip="Проверять сетевые службы собственного ПК по его адресу в выбранной сети." />
          <Grid ColumnDefinitions="200,*" ColumnSpacing="8" IsVisible="{Binding IsCustomProfile}">
            <TextBlock Text="Пользовательские TCP-порты:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding CustomPorts, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: 22,80,443,8000-8010" />
          </Grid>
          <TextBlock Text="{Binding CustomPortsError}" IsVisible="{Binding HasCustomPortsError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="3" Spacing="5">
      <TextBlock Text="{Binding ReadinessText}" IsVisible="{Binding HasReadinessMessage}" Classes="subtitle" />
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CompactStatus}" IsVisible="{Binding ShowAuditStatus}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding AuditNotice}" IsVisible="{Binding HasAuditNotice}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
      <ProgressBar Value="{Binding ProgressPercent}" IsVisible="{Binding IsAuditing}" Minimum="0" Maximum="100" Height="3" />
      <Grid ColumnDefinitions="*,190,120,75,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="IP, имя, служба или продукт" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayModes}" SelectedIndex="{Binding SelectedDisplayModeIndex}" HorizontalAlignment="Stretch" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding ServiceFilters}" SelectedIndex="{Binding SelectedServiceIndex}" HorizontalAlignment="Stretch" />
        <TextBox Grid.Column="3" Text="{Binding PortFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Порт" />
        <Button Grid.Column="4" Content="Подробности" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="Показать или скрыть сведения выбранной строки." />
      </Grid>
      <TextBlock Text="{Binding FilterError}" IsVisible="{Binding HasFilterError}" Foreground="{DynamicResource ErrorBrush}" />
    </StackPanel>
    <Grid Grid.Row="4" x:Name="ResultsLayout" ColumnDefinitions="*" RowDefinitions="*" ClipToBounds="True">
      <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid>
          <TableView x:Name="AuditResultsTable" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" CanUserResizeColumns="True" ScrollViewer.AllowAutoHide="False">
            <TableView.Columns>
              <TableViewColumn Header="IP" Binding="{ReflectionBinding Address}" Width="120" />
              <TableViewColumn Header="Имя" Binding="{ReflectionBinding Name}" Width="140" />
              <TableViewColumn Header="Порт" Binding="{ReflectionBinding Port}" Width="60" />
              <TableViewColumn Header="Протокол" Binding="{ReflectionBinding Protocol}" Width="85" />
              <TableViewColumn Header="Продукт" Binding="{ReflectionBinding Product}" Width="140" />
              <TableViewColumn Header="Обнаруженные ресурсы" Binding="{ReflectionBinding DiscoveredResources}" Width="290" />
            </TableView.Columns>
          </TableView>
          <TextBlock Text="{Binding EmptyResultsText}" IsVisible="{Binding IsResultsEmpty}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" MaxWidth="560" />
        </Grid>
      </Border>
      <Border x:Name="AuditDetailsPanel" Classes="card" IsVisible="{Binding IsDetailsExpanded}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding SelectionHeading}" Classes="section" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectionProduct}" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" IsVisible="{Binding !HasFileService}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding SelectionStatus}" Classes="subtitle" />
            <TextBlock Text="{Binding HttpAvailabilityText}" IsVisible="{Binding !HasSites}" Classes="subtitle" />
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasMultipleSites}" ColumnSpacing="8">
              <Button Content="‹" Command="{Binding PreviousSiteCommand}" ToolTip.Tip="Предыдущий сайт службы" />
              <TextBlock Grid.Column="1" Text="{Binding SitePosition}" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <Button Grid.Column="2" Content="›" Command="{Binding NextSiteCommand}" ToolTip.Tip="Следующий сайт службы" />
            </Grid>
            <SelectableTextBlock Text="{Binding SiteAddress}" IsVisible="{Binding HasSites}" TextWrapping="Wrap" />
            <Button Content="Открыть сайт" Command="{Binding OpenSiteCommand}" IsVisible="{Binding HasSites}" HorizontalAlignment="Left" />
            <StackPanel Spacing="6" IsVisible="{Binding HasHttpExchange}">
              <TextBlock Text="HTTP-запрос" Classes="section" />
              <TextBox x:Name="HttpRequestTextBox" Text="{Binding HttpRequestText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace" TextWrapping="Wrap" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <TextBlock Text="HTTP-ответ" Classes="section" />
              <TextBox x:Name="HttpResponseTextBox" Text="{Binding HttpResponseText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace" TextWrapping="Wrap" Height="150" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" IsVisible="{Binding HasFileService}" RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="{Binding FileServiceEvidence}" TextWrapping="Wrap" Classes="subtitle" />
            <Grid Grid.Row="1" DataContext="{Binding Catalog}" x:DataType="vm:ResourceCatalogViewModel" RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <ProgressBar IsVisible="{Binding IsWorking}" IsIndeterminate="True" Height="3" />
                <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6">
                  <StackPanel IsEnabled="{Binding !IsWorking}" Spacing="6">
                    <TextBox Text="{Binding SharePath}" IsVisible="{Binding IsSmb}" PlaceholderText="UNC-путь общей папки" />
                    <ComboBox ItemsSource="{Binding LoginModes}" SelectedIndex="{Binding LoginMode}" HorizontalAlignment="Stretch" />
                    <Grid IsVisible="{Binding HasNamedLogin}" ColumnDefinitions="*,*" ColumnSpacing="6">
                      <TextBox Text="{Binding UserName}" PlaceholderText="Пользователь" />
                      <TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="●" PlaceholderText="Пароль" />
                    </Grid>
                    <CheckBox IsChecked="{Binding AllowPlaintext}" IsVisible="{Binding NeedsPlaintextConsent}">
                      <TextBlock Text="Разрешаю передать данные по FTP без шифрования" TextWrapping="Wrap" />
                    </CheckBox>
                    <WrapPanel ItemSpacing="6" LineSpacing="5">
                      <Button Content="Открыть ресурс" Command="{Binding ReadRootCommand}" IsEnabled="{Binding CanRead}" />
                      <Button Content="Обновить" Command="{Binding RefreshCatalogCommand}" IsEnabled="{Binding CanRead}" />
                      <Button Content="Вверх" Command="{Binding ParentFolderCommand}" IsEnabled="{Binding CanGoUp}" />
                    </WrapPanel>
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding CurrentPath}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
              <TableView Grid.Row="1" IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" CanUserResizeColumns="True">
                <TableView.Columns>
                  <TableViewColumn Header="Имя" Binding="{ReflectionBinding Name}" Width="170" />
                  <TableViewColumn Header="Тип" Binding="{ReflectionBinding KindText}" Width="65" />
                  <TableViewColumn Header="Байт" Binding="{ReflectionBinding SizeText}" Width="80" />
                  <TableViewColumn Header="Изменён" Binding="{ReflectionBinding ModifiedText}" Width="125" />
                  <TableViewColumn Header="Доступ" Binding="{ReflectionBinding AccessText}" Width="140" />
                </TableView.Columns>
              </TableView>
              <StackPanel Grid.Row="2" IsVisible="{Binding IsExpanded}" Spacing="5">
                <WrapPanel ItemSpacing="6" LineSpacing="5">
                  <Button Content="Открыть папку" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding CanOpenFolder}" />
                  <Button Content="Копировать путь" Click="CopyResourcePath" />
                  <Button Content="Остановить" Command="{Binding CancelCatalogueCommand}" IsEnabled="{Binding IsWorking}" />
                </WrapPanel>
                <TextBlock Text="{Binding Counts}" TextWrapping="Wrap" Classes="subtitle" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
