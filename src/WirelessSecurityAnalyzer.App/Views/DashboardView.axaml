<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" x:Class="WirelessSecurityAnalyzer.App.Views.DashboardView" x:DataType="vm:DashboardViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" MaxWidth="1050" HorizontalAlignment="Left">
      <StackPanel Spacing="5">
        <TextBlock Text="Главная" Classes="title" />
        <TextBlock Text="Сеть → устройства → службы и сайты" Classes="subtitle" />
      </StackPanel>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,20">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <StackPanel Spacing="6">
            <TextBlock Text="Следующий шаг" Classes="section" />
            <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="HomePrimaryButton" Content="{Binding NextActionText}" Command="{Binding ContinueCommand}" Classes="primary" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="18" ColumnSpacing="16">
        <TextBlock Text="1. Сеть" Classes="section" />
        <TextBlock Grid.Column="1" Text="{Binding NetworkStatus}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="2. Устройства" Classes="section" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscoveryStatus}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="3. Службы и сайты" Classes="section" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuditStatus}" TextWrapping="Wrap" />
      </Grid>
      <WrapPanel>
        <Button Content="Эфир Wi-Fi" Classes="link" Command="{Binding NavigateCommand}" CommandParameter="Эфир" Margin="0,0,16,4" />
        <Button Content="Устройства" Classes="link" Command="{Binding NavigateCommand}" CommandParameter="Устройства" Margin="0,0,16,4" />
        <Button Content="Сетевой аудит" Classes="link" Command="{Binding NavigateCommand}" CommandParameter="Сетевой аудит" />
      </WrapPanel>
      <StackPanel Spacing="4" IsVisible="{Binding HasRecentAir}">
        <TextBlock Text="Сохранённые результаты эфира" Classes="section" />
        <TextBlock Text="{Binding RecentAir}" Classes="subtitle" />
      </StackPanel>
      <StackPanel IsVisible="{Binding HasLogWarning}" Spacing="6">
        <TextBlock Text="{Binding LogWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
        <Button Content="Настроить журналы" Command="{Binding NavigateCommand}" CommandParameter="Настройки" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
