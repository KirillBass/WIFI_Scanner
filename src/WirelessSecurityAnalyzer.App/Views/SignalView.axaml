<controls:PlotViewBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WirelessSecurityAnalyzer.App.Controls" xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels"
             xmlns:plot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="WirelessSecurityAnalyzer.App.Views.SignalView" x:DataType="vm:SignalViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Сигнал" Classes="title" />

    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,95,Auto,Auto,Auto" ColumnSpacing="8">
      <ComboBox ItemsSource="{Binding AccessPoints}" SelectedItem="{Binding SelectedAccessPoint}" IsEnabled="{Binding CanChangeSelection}" PlaceholderText="Выберите точку доступа / MAC-адрес" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AccessPointRowViewModel"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="1" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedIntervalSeconds}" IsEnabled="{Binding CanChangeSelection}" HorizontalAlignment="Stretch" ToolTip.Tip="Интервал мониторинга">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="x:Int32"><TextBlock Text="{Binding StringFormat='{}{0} сек'}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="Запустить" Classes="primary" Command="{Binding StartMonitoringCommand}" />
      <Button Grid.Column="3" Content="Остановить" Command="{Binding StopMonitoringCommand}" />
      <Button Grid.Column="4" Content="Очистить" Command="{Binding ClearHistoryCommand}" />
    </Grid>
    <StackPanel Grid.Row="2" Spacing="5">
      <WrapPanel>
        <TextBlock Text="{Binding SelectedBssid, StringFormat='MAC-адрес: {0}'}" Margin="0,0,16,0" Classes="subtitle" />
        <TextBlock Text="{Binding SelectedChannel, StringFormat='Канал: {0}'}" Margin="0,0,16,0" Classes="subtitle" />
        <TextBlock Text="{Binding SelectedBand}" Classes="subtitle" />
      </WrapPanel>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock Text="Останавливаем…" IsVisible="{Binding IsStopping}" Classes="subtitle" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WifiErrorTemplate}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
      <TextBlock Text="Текущий RSSI" Classes="subtitle" /><TextBlock Grid.Column="1" Text="Средний" Classes="subtitle" />
      <TextBlock Grid.Column="2" Text="Минимальный" Classes="subtitle" /><TextBlock Grid.Column="3" Text="Максимальный" Classes="subtitle" />
      <TextBlock Grid.Row="1" Text="{Binding CurrentRssiText}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AverageRssiText}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MinimumRssiText}" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MaximumRssiText}" />
      <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding SignalQualityText}" Classes="subtitle" />
    </Grid>
    <Border Grid.Row="4" Classes="card" Padding="5" ClipToBounds="True">
      <Grid>
        <plot:AvaPlot x:Name="SignalPlot" />
        <Border Background="{DynamicResource CardBrush}" IsVisible="{Binding !HasSamples}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14">
          <TextBlock Text="График появится после первого измерения" Classes="subtitle" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" IsVisible="{Binding HasSamples}">
      <TextBlock Text="{Binding LastSeenText, StringFormat='Последнее измерение: {0}'}" Classes="subtitle" />

    </Grid>
  </Grid>
</controls:PlotViewBase>
