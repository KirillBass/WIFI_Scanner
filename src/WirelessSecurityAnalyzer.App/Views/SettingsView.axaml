<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" x:Class="WirelessSecurityAnalyzer.App.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="14" MaxWidth="950" HorizontalAlignment="Left">
    <TextBlock Text="Настройки" Classes="title" />
    <TextBlock Text="Папка журналов" Classes="section" />
    <TextBlock Text="Журнал помогает разобраться в ошибках подключения и сканирования." Classes="subtitle" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding !IsBusy}">
      <TextBox x:Name="LogDirectoryText" Text="{Binding SelectedDirectory}" IsReadOnly="True" MinWidth="450" />
      <Button Grid.Column="1" x:Name="ChooseLogDirectoryButton" Content="Изменить…" Command="{Binding ChangeDirectoryCommand}" />
    </Grid>
    <WrapPanel>
      <Button Content="Открыть текущую папку" Command="{Binding OpenDirectoryCommand}" Margin="0,0,10,4" />
      <Button Content="Сбросить путь по умолчанию" Command="{Binding ResetDirectoryCommand}" />
    </WrapPanel>
    <StackPanel Spacing="4" IsVisible="{Binding UsesDifferentDirectory}">
      <TextBlock Text="Сейчас журнал записывается в:" Classes="subtitle" />
      <TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Text="{Binding StatusText}" Classes="subtitle" />
    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    <TextBlock Text="{Binding WarningMessage}" IsVisible="{Binding HasWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    <TextBlock Text="Журналы хранятся локально. Ротация ежедневная, сохраняются 14 последних файлов." Classes="subtitle" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
