<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBrush" Color="#10151E" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#151C28" />
  <SolidColorBrush x:Key="CardBrush" Color="#1B2432" />
  <SolidColorBrush x:Key="BorderBrush" Color="#303D50" />
  <SolidColorBrush x:Key="TextBrush" Color="#EEF2F8" />
  <SolidColorBrush x:Key="MutedBrush" Color="#98A6BA" />
  <SolidColorBrush x:Key="AccentBrush" Color="#65A9FA" />
  <SolidColorBrush x:Key="SignalBrush" Color="#59D69B" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F4CE6B" />
  <SolidColorBrush x:Key="HighLoadBrush" Color="#F29958" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FA7D87" />
</ResourceDictionary>
